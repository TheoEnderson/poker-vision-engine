# =============================================================================
# Poker Analytics Engine (PAE) - Environment Variables Configuration Example
# =============================================================================

# Identificador do Hero na Mesa (Nick/Nome exibido na interface do poker)
HERO_IDENTIFIER=The_Ment_End

# Coordenadas da Região de Interesse (ROI) do Pote na Tela
POT_ROI_TOP=210
POT_ROI_LEFT=850
POT_ROI_WIDTH=220
POT_ROI_HEIGHT=60

# Coordenadas da Região de Interesse (ROI) dos Botões de Ação (Fold/Check/Call/Bet)
ACTION_ROI_TOP=870
ACTION_ROI_LEFT=1200
ACTION_ROI_WIDTH=650
ACTION_ROI_HEIGHT=150

# Limiares de Confiança para Reconhecimento de Cartas (Template Matching)
RANK_THRESHOLD=0.68
SUIT_THRESHOLD=0.68

# Parâmetros de Filtro de Feltro Verde e Brilho das Cartas
CARD_BRIGHTNESS_THRESHOLD=150
MAX_GREEN_RATIO=0.40

# Teto de Sanidade Máxima para Leitura de Pote via OCR
MAX_REALISTIC_POT=10000.0

# Regras de Risco e Gestão de Stack
HEAVY_BET_STACK_RATIO=0.40
MICRO_BET_STACK_RATIO=0.02
PREFLOP_SPEC_RATIO=0.025

# Parâmetros do Assistente ao Vivo
DEFAULT_HERO_STACK=1000.0
DEFAULT_NUM_OPPONENTS=4
MONTE_CARLO_ITERATIONS=10000
POLL_INTERVAL=0.5
